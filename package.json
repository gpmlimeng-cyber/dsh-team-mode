{
  "name": "@limeng/dsh-team-mode",
  "version": "0.4.0",
  "description": "DSH-Team Mode: AionUi-style multi-agent Team Mode for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpmlimeng-cyber/dsh-team-mode.git"
  },
  "homepage": "https://github.com/gpmlimeng-cyber/dsh-team-mode#readme",
  "bugs": {
    "url": "https://github.com/gpmlimeng-cyber/dsh-team-mode/issues"
  },
  "author": "gpmlimeng <412566213@qq.com>",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "team-mode",
    "aionui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "!lib/*.map",
    "lib/index.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "docs/*.md",
    "!docs/HANDOFF.md",
    "!docs/UI-REVIEW.md",
    "docs/assets/dsh-team-mode/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "tsdown --clean",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run guard:architecture && npm run typecheck && npm run test && npm run build",
    "guard:architecture": "node scripts/check-architecture.mjs",
    "release:smoke": "node scripts/release-smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@pierre/diffs": "^1.3.5",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "4.4.3"
  }
}
